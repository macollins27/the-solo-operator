---
// Zero-cookie posture: this site sets no cookies on any route.
// No auth, no analytics, no third-party scripts, no service workers, no
// consent banner. The CSP in public/_headers blocks third-party origins.
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-sans-condensed/500.css';
import '@fontsource/ibm-plex-sans-condensed/600.css';
import '@fontsource/ibm-plex-sans-condensed/700.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { CHAPTERS } from '../lib/chapters';

interface Props {
  title: string;
  description: string;
  pageType?: 'home' | 'article' | 'index';
  ogImage?: string;
  noIndex?: boolean;
  structuredData?: object;
}

const {
  title,
  description,
  pageType = 'article',
  ogImage,
  noIndex = false,
  structuredData,
} = Astro.props;

const SITE_NAME = 'How to Use Claude Code';
const SITE_URL = Astro.site?.toString().replace(/\/$/, '') ?? 'https://how-to-use-claude-code.example';
const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
const fullTitle = pageType === 'home' ? title : `${title} · ${SITE_NAME}`;

// Resolve an OG image path from the page URL when the caller did not pass one.
// Every public route has a matching /og/<slug>.png generated by
// src/pages/og/[slug].png.ts. Final shipped URLs are absolute via SITE_URL
// so link-preview crawlers resolve them.
function resolveOgPath(pathname: string): string {
  const stripped = pathname.replace(/\.html$/, '').replace(/\/$/, '');
  const clean = stripped === '' ? '/' : stripped;
  if (clean === '/') return '/og/home.png';
  if (clean === '/404') return '/og/404.png';
  const chapterMatch = clean.match(/^\/([0-9]{2}-[a-z-]+)$/);
  if (chapterMatch) return `/og/${chapterMatch[1]}.png`;
  return '/og/default.png';
}

const ogImageUrl = new URL(ogImage ?? resolveOgPath(Astro.url.pathname), SITE_URL).toString();

const currentPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';

function isActive(slug: string): boolean {
  if (slug === '') return currentPath === '/';
  return currentPath === `/${slug}`;
}

const defaultSchema =
  pageType === 'home'
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_NAME,
        description,
        url: SITE_URL,
        inLanguage: 'en',
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        headline: title,
        description,
        url: canonical,
        isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: SITE_URL },
        inLanguage: 'en',
      };
const schema = structuredData ?? defaultSchema;

// Escape `</` to `<\/` so JSON-LD content cannot break out of the inline
// <script> block.
function safeJsonLd(obj: object): string {
  return JSON.stringify(obj).replace(/<\//g, '<\\/');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0d10" />
    <meta name="color-scheme" content="dark" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {noIndex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content={pageType === 'home' ? 'website' : 'article'} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />

    {
      /* Font preload tags are injected at build time by src/integrations/font-preload.ts. */
    }

    <script is:inline type="application/ld+json" set:html={safeJsonLd(schema)} />

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="topnav" transition:persist transition:name="topnav">
      <nav class="container" aria-label="Primary">
        <a href="/" class="brand">
          <span>HOW TO USE</span>
          <span class="sl">/</span>
          <span class="doc">Claude Code</span>
        </a>
        <span class="spacer"></span>
        <div class="sects">
          {
            CHAPTERS.map((c) => {
              const href = c.slug === '' ? '/' : `/${c.slug}`;
              return (
                <a href={href} class={isActive(c.slug) ? 'active' : ''}>
                  <span class="n">{c.n}</span>
                  {c.short}
                </a>
              );
            })
          }
        </div>
        <button
          type="button"
          class="cmd-trigger"
          aria-label="Open search"
          data-cmd-open
        >
          Search <kbd>⌘K</kbd>
        </button>
        <button
          type="button"
          class="menu-button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-mobile-toggle
        >
          Menu
        </button>
        <div class="mobile-menu" id="mobile-menu" data-open="false">
          {
            CHAPTERS.map((c) => {
              const href = c.slug === '' ? '/' : `/${c.slug}`;
              return (
                <a href={href} class={isActive(c.slug) ? 'active' : ''}>
                  <span class="n">{c.n}</span>
                  {c.label}
                </a>
              );
            })
          }
        </div>
      </nav>
    </header>

    <reading-progress></reading-progress>

    <main id="main">
      <slot />
    </main>

    <command-palette></command-palette>

    <footer class="site-footer" transition:persist transition:name="site-footer">
      <div class="container">
        <span>{SITE_NAME}</span>
        <span>
          <a href="/llms-full.txt">llms-full.txt</a> &nbsp;·&nbsp;
          <a href="/sitemap-index.xml">Sitemap</a>
        </span>
      </div>
    </footer>

    <script>
      import '../components/CopyButton.ts';
      import '../components/CommandPalette.ts';
      import '../components/ReadingProgress.ts';
      import '../components/topnav.ts';
    </script>
  </body>
</html>
