---
import Base from '../../layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

type FoundationEntry = CollectionEntry<'foundations'>;
interface Props {
  entry: FoundationEntry;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const entries: FoundationEntry[] = await getCollection('foundations');
  return entries.map((entry: FoundationEntry) => ({
    params: { slug: entry.id },
    props: { entry } satisfies Props,
  }));
};

const { entry } = Astro.props as Props;
const d = entry.data;
const { Content } = await render(entry);

type PhrasebookEntry = CollectionEntry<'phrasebook'>;
const allPhrasebook: PhrasebookEntry[] = await getCollection('phrasebook');
const related: PhrasebookEntry[] = d.relatedPhrasebook
  .map((slug: string) => allPhrasebook.find((p: PhrasebookEntry) => p.id === slug))
  .filter((p: PhrasebookEntry | undefined): p is PhrasebookEntry => p !== undefined);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const entryUrl = new URL(Astro.url.pathname, Astro.site).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      headline: d.title,
      description: d.description,
      url: entryUrl,
      datePublished: d.pubDate.toISOString(),
      ...(d.updated && { dateModified: d.updated.toISOString() }),
      articleSection: 'Start Here',
      inLanguage: 'en',
      isPartOf: {
        '@type': 'WebSite',
        name: "The Solo Operator's Manual",
        url: siteUrl,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Start Here',
          item: `${siteUrl}/start-here`,
        },
        { '@type': 'ListItem', position: 3, name: d.title, item: entryUrl },
      ],
    },
  ],
};
---

<Base
  title={d.title}
  description={d.description}
  pageType="article"
  structuredData={structuredData}
>
  <reading-progress></reading-progress>
  <article class="container">
    <header class="entry-header">
      <p class="kicker">Start Here &middot; {d.n}</p>
      <h1 class="h-display entry">{d.title}</h1>
      <p class="subtle" style="margin-top:8px; margin-bottom:0">{d.summary}</p>
    </header>

    <div class="pgrid">
      <div class="prose-block">
        <Content />

        {
          d.pasteExamples.length > 0 && (
            <section class="block" aria-labelledby="block-pastes" style="margin-top:48px">
              <h2 id="block-pastes">Paste-ready phrasings</h2>
              {d.pasteExamples.map((ex: { label: string; text: string }, i: number) => (
                <div style={`margin-top:${i === 0 ? '14px' : '22px'}`}>
                  <p
                    class="body-copy"
                    style="margin-bottom:6px; color:var(--muted); font-size:13px"
                  >
                    {ex.label}
                  </p>
                  <div class="paste-block">
                    <div class="head">
                      <span class="label">Paste this</span>
                      <copy-button data-state="idle">Copy</copy-button>
                    </div>
                    <div class="body">
                      <pre>{ex.text.trim()}</pre>
                    </div>
                  </div>
                </div>
              ))}
            </section>
          )
        }
      </div>

      <aside class="receipts" aria-label="Related phrasebook entries">
        <header class="head">
          <span class="title">Related phrasebook entries</span>
        </header>
        {
          related.map((p: PhrasebookEntry) => (
            <div class="stat">
              <a
                href={`/phrasebook/${p.id}`}
                style="color:var(--blue); font-family:var(--mono); font-size:13px; line-height:1.5; display:block"
              >
                "{p.data.quote}" &rarr;
              </a>
            </div>
          ))
        }
        <p class="note">
          These are specific phrasings the agent might emit that this foundation move applies to.
          Each one has its own entry with words to say back.
        </p>
      </aside>
    </div>

    <div class="rev-strip">
      <span>{d.n} &middot; foundation move</span>
      <span>
        <a href="/start-here" style="color:inherit">All five moves &rarr;</a>
      </span>
    </div>
  </article>
</Base>

<style>
  .prose-block :global(h2) {
    font-family: var(--display);
    font-weight: 600;
    font-size: 24px;
    color: var(--text-bright);
    margin: 36px 0 16px;
    line-height: 1.2;
  }
  .prose-block :global(h2:first-child) {
    margin-top: 0;
  }
  .prose-block :global(p) {
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--text);
    margin-bottom: 16px;
    max-width: 760px;
  }
  .prose-block :global(p em) {
    font-style: italic;
    color: var(--text-bright);
  }
  .prose-block :global(p strong) {
    font-weight: 600;
    color: var(--text-bright);
  }
  .prose-block :global(p a) {
    color: var(--blue);
    text-decoration: underline;
    text-decoration-color: rgba(88, 166, 255, 0.4);
    text-underline-offset: 2px;
  }
  .prose-block :global(p a:hover) {
    text-decoration-color: var(--blue);
  }
  .prose-block :global(ul),
  .prose-block :global(ol) {
    margin: 0 0 18px 24px;
    max-width: 720px;
  }
  .prose-block :global(li) {
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--text);
    margin-bottom: 8px;
  }
  .prose-block :global(li strong) {
    color: var(--text-bright);
  }
  @media (min-width: 1024px) {
    .prose-block :global(h2) {
      font-size: 28px;
      margin: 44px 0 18px;
    }
  }
</style>
