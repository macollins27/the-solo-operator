---
import Base from '../../layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { CATEGORIES, type CategoryKey } from '../../lib/categories';

type PhrasebookEntry = CollectionEntry<'phrasebook'>;
interface Props {
  entry: PhrasebookEntry;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const entries: PhrasebookEntry[] = await getCollection('phrasebook');
  return entries.map((entry: PhrasebookEntry) => ({
    params: { slug: entry.id },
    props: { entry } satisfies Props,
  }));
};

const { entry } = Astro.props as Props;
const d = entry.data;
const cat = CATEGORIES[d.category as CategoryKey];

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const entryUrl = new URL(Astro.url.pathname, Astro.site).toString();

const recognizeText = `Listen for any of: ${d.hearing.join(' / ')}`;
const verifyText =
  d.afterPaste?.trim() ??
  'Read the agent’s next reply. If it returns to concrete action — a command, a file, an error — you have ground truth. If it returns more abstraction, push again.';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      headline: d.title,
      description: d.description,
      url: entryUrl,
      datePublished: d.pubDate.toISOString(),
      ...(d.updated && { dateModified: d.updated.toISOString() }),
      articleSection: cat.label,
      inLanguage: 'en',
      isPartOf: {
        '@type': 'WebSite',
        name: "The Solo Operator's Manual",
        url: siteUrl,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${siteUrl}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'The Phrasebook',
          item: `${siteUrl}/phrasebook`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: cat.label,
          item: `${siteUrl}/phrasebook#cat-${d.category}`,
        },
        {
          '@type': 'ListItem',
          position: 4,
          name: d.title,
          item: entryUrl,
        },
      ],
    },
    {
      '@type': 'HowTo',
      name: `How to push back when your agent says "${d.quote}"`,
      description: d.subtitle,
      inLanguage: 'en',
      totalTime: 'PT2M',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: "Recognize the agent's words",
          text: recognizeText,
          url: `${entryUrl}#block-hearing`,
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Paste the intervention',
          text: d.pasteText.trim(),
          url: `${entryUrl}#block-paste`,
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: "Verify the agent's response",
          text: verifyText,
          url: `${entryUrl}#block-why`,
        },
      ],
    },
  ],
};
---

<Base
  title={d.title}
  description={d.description}
  pageType="article"
  structuredData={structuredData}
>
  <reading-progress aria-label="Reading progress"></reading-progress>
  <article class="container">
    <header class="entry-header">
      <p class="kicker">Phrasebook &middot; Category {cat.number} &middot; {cat.label}</p>
      <h1 class="h-display entry">Your agent says <em>"{d.quote}."</em></h1>
      <p class="subtle" style="margin-top:8px; margin-bottom:0">{d.subtitle}</p>
    </header>

    <div class="pgrid">
      <div>
        <section class="block" aria-labelledby="block-hearing">
          <h2 id="block-hearing">What you're hearing</h2>
          <ul class="hear-list">
            {
              d.hearing.map((line: string) => (
                <li>
                  <em>{line}</em>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="block" aria-labelledby="block-paste">
          <h2 id="block-paste">What to say back</h2>
          <div class="paste-block">
            <div class="head">
              <span class="label">Paste this</span>
              <copy-button data-state="idle">Copy</copy-button>
            </div>
            <div class="body">
              <pre>{d.pasteText.trim()}</pre>
            </div>
          </div>
          {
            d.afterPaste && (
              <p class="body-copy" style="margin-top:18px">
                {d.afterPaste.trim()}
              </p>
            )
          }
        </section>

        <section class="block" aria-labelledby="block-why">
          <h2 id="block-why">Why this works</h2>
          {
            d.whyThisWorks.map((para: string) => (
              <p class="body-copy" set:html={para.replace(/\*(.+?)\*/g, '<em>$1</em>')} />
            ))
          }
        </section>

        <section class="block" aria-labelledby="block-origin">
          <h2 id="block-origin">Where this came from</h2>
          <div class="story">
            {
              d.whereThisCameFrom.map((para: string) => (
                <p set:html={para.replace(/\*(.+?)\*/g, '<em>$1</em>')} />
              ))
            }
          </div>
        </section>
      </div>

      <aside class="receipts" aria-label="Corpus receipts">
        <header class="head">
          <span class="title">Receipts</span>
          <span class="source">2026-05-14</span>
        </header>
        <div class="stat">
          <div class="label">This pattern appears in</div>
          <div class="val">{d.appears} <small>last refresh</small></div>
        </div>
        <div class="stat">
          <div class="label">Wider category total</div>
          <div class="val">{d.categoryTotal} <small>cat. {cat.number}</small></div>
        </div>
        {
          d.successRate && (
            <div class="stat">
              <div class="label">Approximate first-push success</div>
              <div class="val">{d.successRate}</div>
            </div>
          )
        }
        {
          d.relatedMove && (
            <div class="stat">
              <div class="label">Related foundation move</div>
              <div class="val">
                <a href={`/start-here/${d.relatedMove.slug}`}>{d.relatedMove.label} &rarr;</a>
              </div>
            </div>
          )
        }
        <p class="note">
          Every count on this page is aggregated across <em>1,073 sessions</em>. Client and project
          names are not retained. Refreshed on the first of each month.
        </p>
      </aside>
    </div>

    <div class="rev-strip">
      <span>Phrasebook entry &middot; published {d.pubDate.toISOString().slice(0, 10)}</span>
      {
        d.relatedMove && (
          <span>
            Foundation move:{' '}
            <a href={`/start-here/${d.relatedMove.slug}`} style="color:inherit">
              {d.relatedMove.label}
            </a>
          </span>
        )
      }
    </div>
  </article>
</Base>
