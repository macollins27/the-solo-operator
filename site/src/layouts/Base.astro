---
// Zero-cookie posture (T-503): this site sets no cookies on any route.
// No auth, no analytics, no third-party scripts, no service workers, no
// consent banner. The CSP in public/_headers blocks third-party origins.
// If a future change introduces cookies, update both this comment and the
// security review in _internal/reviews/.
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-sans-condensed/500.css';
import '@fontsource/ibm-plex-sans-condensed/600.css';
import '@fontsource/ibm-plex-sans-condensed/700.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  pageType?: 'home' | 'article' | 'index';
  ogImage?: string;
  noIndex?: boolean;
  structuredData?: object;
}

const {
  title,
  description,
  pageType = 'article',
  ogImage,
  noIndex = false,
  structuredData,
} = Astro.props;

const SITE_NAME = "The Solo Operator's Manual";
const SITE_URL = Astro.site?.toString().replace(/\/$/, '') ?? 'https://solo-operator.example';
const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
const fullTitle = pageType === 'home' ? title : `${title} · ${SITE_NAME}`;

// Resolve an OG image path from the page URL when the caller did not pass one.
// Every public route has a matching /og/<slug>.png generated by
// src/pages/og/[slug].png.ts (Phase 3, T-301 / T-302 / T-303). Final shipped
// URLs are absolute via SITE_URL so link-preview crawlers resolve them.
function resolveOgPath(pathname: string): string {
  // Astro builds with format: 'file', so pathname is e.g. /about.html or
  // /phrasebook/paid-service-claim.html. Strip the suffix before matching.
  const stripped = pathname.replace(/\.html$/, '').replace(/\/$/, '');
  const clean = stripped === '' ? '/' : stripped;
  if (clean === '/') return '/og/home.png';
  if (clean === '/phrasebook') return '/og/phrasebook-index.png';
  if (clean === '/start-here') return '/og/start-here-index.png';
  if (clean === '/about') return '/og/about.png';
  if (clean === '/404') return '/og/404.png';
  const phrasebookMatch = clean.match(/^\/phrasebook\/([^/]+)$/);
  if (phrasebookMatch) return `/og/${phrasebookMatch[1]}.png`;
  const startHereMatch = clean.match(/^\/start-here\/([^/]+)$/);
  if (startHereMatch) return `/og/${startHereMatch[1]}.png`;
  return '/og/default.png';
}

const ogImageUrl = new URL(ogImage ?? resolveOgPath(Astro.url.pathname), SITE_URL).toString();

const navItems = [
  { href: '/phrasebook', label: 'Phrasebook' },
  { href: '/start-here', label: 'Start Here' },
  { href: '/about', label: 'About' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '');

const defaultSchema =
  pageType === 'home'
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_NAME,
        description,
        url: SITE_URL,
        inLanguage: 'en',
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        headline: title,
        description,
        url: canonical,
        isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: SITE_URL },
        inLanguage: 'en',
      };
const schema = structuredData ?? defaultSchema;

// Escape `</` to `<\/` so JSON-LD content can't break out of the inline
// <script> block. See `_internal/reviews/2026-05-15-security-review.md` F-01.
function safeJsonLd(obj: object): string {
  return JSON.stringify(obj).replace(/<\//g, '<\\/');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0d10" />
    <meta name="color-scheme" content="dark" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {noIndex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content={pageType === 'home' ? 'website' : 'article'} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />

    {
      /* Font preload tags are injected at build time by src/integrations/font-preload.ts
        (T-601). Hashed _astro/*.woff2 paths are discovered after the Vite build. */
    }

    <script is:inline type="application/ld+json" set:html={safeJsonLd(schema)} />

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="topnav" transition:persist transition:name="topnav">
      <nav class="container" aria-label="Primary">
        <a href="/" class="brand">
          {SITE_NAME}<small>Living document</small>
        </a>
        <div class="links">
          {
            navItems.map((item) => (
              <a href={item.href} class={currentPath === item.href ? 'active' : ''}>
                {item.label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <command-palette></command-palette>

    <footer class="site-footer" transition:persist transition:name="site-footer">
      <div class="container">
        <span>{SITE_NAME} &middot; Revision 2026-05-15 &middot; Living document</span>
        <span>
          <a href="/about">Where this came from</a> &nbsp;&middot;&nbsp;
          <a href="/sitemap-index.xml">Sitemap</a>
        </span>
      </div>
    </footer>

    <script>
      import '../components/CopyButton.ts';
      import '../components/CommandPalette.ts';
      import '../components/ReadingProgress.ts';
    </script>
  </body>
</html>
