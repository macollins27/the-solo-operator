{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec serve dist -l 4321 --no-clipboard --no-request-logging",
      "startServerReadyPattern": "Accepting connections",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/phrasebook",
        "http://localhost:4321/phrasebook/paid-service-claim",
        "http://localhost:4321/phrasebook/cant-do-something",
        "http://localhost:4321/start-here",
        "http://localhost:4321/start-here/ai-is-the-engineer",
        "http://localhost:4321/about",
        "http://localhost:4321/404"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/404$).+$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "csp-xss": "off",
            "uses-long-cache-ttl": "off",
            "is-on-https": "off",
            "redirects-http": "off",
            "uses-http2": "off"
          }
        },
        {
          "matchingUrlPattern": "/404$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "csp-xss": "off",
            "uses-long-cache-ttl": "off",
            "is-on-https": "off",
            "redirects-http": "off",
            "uses-http2": "off"
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
