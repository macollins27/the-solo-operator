# MembershipKit — environment variables
#
# Copy this file to .env.local and fill in real values for local dev.
# .env.local is gitignored; .env.example stays in the repo as documentation.

# Database (Postgres) — example shape:
#   postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=""

# Better Auth (Chapter 25)
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://127.0.0.1:3000"

# Stripe (Chapter 26)
# Use test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AWS S3 / MinIO (file uploads — later chapters)
S3_ENDPOINT=""
S3_BUCKET="membershipkit"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Soketi (real-time check-ins, Chapter 29)
SOKETI_HOST="127.0.0.1"
SOKETI_PORT="6001"
SOKETI_APP_ID="membershipkit"
SOKETI_APP_KEY=""
SOKETI_APP_SECRET=""

# Anthropic (AI directory search, Chapter 30)
ANTHROPIC_API_KEY=""
