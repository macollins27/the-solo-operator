---
import Base from '../layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

type FoundationEntry = CollectionEntry<'foundations'>;
const moves: FoundationEntry[] = (await getCollection('foundations')).sort(
  (a: FoundationEntry, b: FoundationEntry) => a.data.n.localeCompare(b.data.n),
);

function renderEm(text: string) {
  return text.replace(/\*(.+?)\*/g, '<em>$1</em>');
}
---

<Base
  title="Start Here — Five moves before anything else"
  description="If you are new to operating an AI agent, learn these five foundational moves first. They are the moves the rest of the manual depends on."
  pageType="index"
>
  <div class="container">
    <p class="kicker">Start Here</p>
    <h1 class="h-display chapter">Five moves before anything else.</h1>
    <p class="body-copy">
      If you are new to operating an AI agent, learn these in order. They are the moves the rest of
      the manual depends on. Each one is a single short read.
    </p>

    <div class="moves">
      {
        moves.map((move) => (
          <a class="move" href={`/start-here/${move.id}`}>
            <div class="n">{move.data.n}</div>
            <h2 class="name">{move.data.title}</h2>
            <p class="body-text" set:html={renderEm(move.data.summary)} />
            <span class="more">Read &rarr;</span>
          </a>
        ))
      }
    </div>

    <div class="rev-strip">
      <span>Start Here &middot; Five foundational moves</span>
      <span>
        <a href="/phrasebook" style="color:inherit">Next: the phrasebook &rarr;</a>
      </span>
    </div>
  </div>
</Base>
