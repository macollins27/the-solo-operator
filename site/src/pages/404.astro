---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="The page you were looking for isn't part of this guide. Try the home page or Chapter 01."
  noIndex={true}
>
  <div class="container">
    <section class="chapter-intro">
      <div class="pre">404 · Page not found</div>
      <h1>That page isn't here.</h1>
      <div class="deck">
        Either the page never existed, or it's been retired. Try the home page or jump straight into Chapter 01 below.
      </div>
    </section>
    <nav class="pag" aria-label="Recovery">
      <a class="prev" href="/">
        <div class="k">← Home</div>
        <div class="v"><span class="ar">§ 00</span>Overview</div>
      </a>
      <a class="next" href="/01-mindset">
        <div class="k">Start reading →</div>
        <div class="v">§ 01 The Mindset <span class="ar">→</span></div>
      </a>
    </nav>
  </div>
</Base>
