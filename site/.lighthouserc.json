{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/phrasebook.html",
        "http://localhost/phrasebook/paid-service-claim.html",
        "http://localhost/phrasebook/cant-do-something.html",
        "http://localhost/start-here.html",
        "http://localhost/start-here/ai-is-the-engineer.html",
        "http://localhost/about.html",
        "http://localhost/404.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*404\\.html).+$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "csp-xss": "off",
            "uses-long-cache-ttl": "off",
            "is-on-https": "off",
            "redirects-http": "off",
            "uses-http2": "off"
          }
        },
        {
          "matchingUrlPattern": "404\\.html$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "csp-xss": "off",
            "uses-long-cache-ttl": "off",
            "is-on-https": "off",
            "redirects-http": "off",
            "uses-http2": "off"
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
